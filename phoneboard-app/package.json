{
  "name": "delite-phone-board",
  "productName": "Delite Phone Board",
  "version": "2.1.0",
  "description": "The station's phone lines as a desktop app: SIP settings, one process per line, never throttled (macOS and Windows).",
  "main": "main.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Delite Online",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.11.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.deliteonline.phoneboard",
    "productName": "Delite Phone Board",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload-line.js",
      "preload-board.js",
      "board.html",
      "board.js",
      "icon.png",
      "tray-16.png",
      "tray-32.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Delite Phone Board",
      "runAfterFinish": true,
      "artifactName": "DelitePhoneBoard-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DelitePhoneBoard-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "The phone lines use the station feed as their audio input."
      },
      "artifactName": "DelitePhoneBoard-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "artifactName": "DelitePhoneBoard-${version}-mac-${arch}.${ext}"
    }
  }
}
