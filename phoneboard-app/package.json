{
  "name": "delite-phone-board",
  "productName": "Delite Phone Board",
  "version": "1.0.0",
  "description": "Desktop window for the Delite Online VDO.Ninja phone switchboard (never throttled, single instance, tray, starts with Windows).",
  "main": "main.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Delite Online",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "44.11.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.deliteonline.phoneboard",
    "productName": "Delite Phone Board",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "icon.png",
      "tray-16.png",
      "tray-32.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Delite Phone Board",
      "runAfterFinish": true,
      "artifactName": "DelitePhoneBoard-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DelitePhoneBoard-${version}-portable.${ext}"
    }
  }
}
